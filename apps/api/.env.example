# Local JSON storage requires no database configuration.
# Cloud/staging/production:
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL_MODE=require
PG_POOL_MAX=3
PORT=3001

# Google Sign-In for techs (Slice A): leave ALL of these unset to keep
# Google sign-in disabled (the code is inert without them). Create the
# OAuth client in Google Cloud Console (see the Slice A activation
# checklist in the PR) and set:
#   GOOGLE_OIDC_CLIENT_ID=
#   GOOGLE_OIDC_CLIENT_SECRET (the client secret value; server-side only)
#   GOOGLE_OIDC_REDIRECT_URI=https://<api-host>/api/v1/auth/google/callback
#   GOOGLE_OIDC_WEB_ORIGIN=https://<web-host>
# Shop timezone for availability windows + the schedule board:
#   OPERATOR_TIMEZONE=America/New_York
