# Local JSON storage requires no database configuration.
# Cloud/staging/production:
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL_MODE=require
PG_POOL_MAX=3
PORT=3001

# Google Sign-In for techs (Slice A): leave ALL of these unset to keep
# Google sign-in disabled (the code is inert without them). Create the
# OAuth client in Google Cloud Console (see the Slice A activation
# checklist in the PR) and set:
#   GOOGLE_OIDC_CLIENT_ID=
#   GOOGLE_OIDC_CLIENT_SECRET (the client secret value; server-side only)
#   GOOGLE_OIDC_REDIRECT_URI=https://<api-host>/api/v1/auth/google/callback
#   GOOGLE_OIDC_WEB_ORIGIN=https://<web-host>
# Shop timezone for availability windows + the schedule board:
#   OPERATOR_TIMEZONE=America/New_York

# Brain Gateway ("the Door"): one POST /brain for Web, WhatsApp, Siri
# and phone. Keys are comma-separated lists; staff keys gate order_glass.
# Without keys (and not in production) the gateway accepts the dev key
# "dev-brain-key" — set real keys before deploying anywhere shared.
#   BRAIN_API_KEYS=key-one,key-two
#   BRAIN_STAFF_API_KEYS=staff-key-one
# Usage prices live in config/brain-pricing.json (single source of
# truth); per-key env overrides, e.g. BRAIN_PRICE_DECODE=0.15.
#   BRAIN_PRICING_CONFIG=/path/to/brain-pricing.json
#   BRAIN_AUDIT_LOG=/path/to/gateway-audit.jsonl
#   BRAIN_RATE_LIMIT_MAX=20
#   BRAIN_RATE_LIMIT_WINDOW_MS=600000
