# Local JSON storage requires no database configuration.
# Cloud/staging/production:
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL_MODE=require
PG_POOL_MAX=3
PORT=3001

# Google Sign-In for techs (Slice A): leave ALL of these unset to keep
# Google sign-in disabled (the code is inert without them). Create the
# OAuth client in Google Cloud Console (see the Slice A activation
# checklist in the PR) and set:
#   GOOGLE_OIDC_CLIENT_ID=
#   GOOGLE_OIDC_CLIENT_SECRET (the client secret value; server-side only)
#   GOOGLE_OIDC_REDIRECT_URI=https://<api-host>/api/v1/auth/google/callback
#   GOOGLE_OIDC_WEB_ORIGIN=https://<web-host>
# Shop timezone for availability windows + the schedule board:
#   OPERATOR_TIMEZONE=America/New_York

# Customer email (quote + invoice + 24h unsigned-quote reminders,
# Nelly 2026-11-23). There is NO fake-send mode: without full SMTP
# configuration every customer email records an EMAIL_NOT_CONFIGURED
# failure and health reports email_provider="unconfigured".
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=<smtp host, e.g. smtp.gmail.com>
#   SMTP_PORT=465
#   SMTP_USER=<smtp login>
#   SMTP_PASS=<smtp password / app password>
#   EMAIL_FROM=<from address, e.g. R&R Finest Auto Glass <RRsFinest1@gmail.com>>
# Shared secret the scheduled quote-reminders workflow presents in
# the x-cron-secret header (a staff session also works):
#   QUOTE_REMINDER_CRON_SECRET=
